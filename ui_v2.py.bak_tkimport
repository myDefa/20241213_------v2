class WinGUI(Window):
    def __init__(self):
        super().__init__(themename="cosmo", hdpi=False)
        self.__win()
        self.tk_label_title = self.__tk_label_title(self)

        self.tk_text_show_filepath = self.__tk_text_show_filepath(self)
        self.tk_text_bgcolor_demo = self.__tk_text_bgcolor_demo(self)
        self.tk_text_Result = self.__tk_text_Result(self)

        self.tk_input_keyword1 = self.__tk_input_keyword1(self)
        self.tk_input_keyword2 = self.__tk_input_keyword2(self)
        self.tk_input_keyword3 = self.__tk_input_keyword3(self)
        self.tk_input_keyword4 = self.__tk_input_keyword4(self)
        self.tk_button_search1 = self.__tk_button_search1(self)
        self.tk_button_search2 = self.__tk_button_search2(self)
        self.tk_button_search3 = self.__tk_button_search3(self)
        self.tk_button_search4 = self.__tk_button_search4(self)

        self.tk_button_upload_file = self.__tk_button_upload_file(self)

        self.ext_icon_battery = self.__ext_icon_battery(self)
        self.ext_icon_qq = self.__ext_icon_qq(self)
        self.ext_icon_wifi = self.__ext_icon_wifi(self)
        self.ext_icon_volume = self.__ext_icon_volume(self)
        self.ext_icon_rss = self.__ext_icon_rss(self)
        self.tk_text_time = self.__tk_text_time(self)
        self.ext_icon_earphone = self.__ext_icon_earphone(self)
        self.ext_icon_return = self.__ext_icon_return(self)
        self.ext_icon_chat = self.__ext_icon_chat(self)
        self.ext_icon_switch = self.__ext_icon_switch(self)

        self.update_time()

    def __win(self):
        self.title("小三月の工具箱")
        # 设置窗口大小、居中
        width = 1000
        height = 500
        screenwidth = self.winfo_screenwidth()
        screenheight = self.winfo_screenheight()
        geometry = '%dx%d+%d+%d' % (width, height, (screenwidth - width) / 2, (screenheight - height) / 2)
        self.geometry(geometry)
        
        self.resizable(width=False, height=False)
        
    def scrollbar_autohide(self,vbar, hbar, widget):
        """自动隐藏滚动条"""
        def show():
            if vbar: vbar.lift(widget)
            if hbar: hbar.lift(widget)
        def hide():
            if vbar: vbar.lower(widget)
            if hbar: hbar.lower(widget)
        hide()
        widget.bind("<Enter>", lambda e: show())
        if vbar: vbar.bind("<Enter>", lambda e: show())
        if vbar: vbar.bind("<Leave>", lambda e: hide())
        if hbar: hbar.bind("<Enter>", lambda e: show())
        if hbar: hbar.bind("<Leave>", lambda e: hide())
        widget.bind("<Leave>", lambda e: hide())
    
    def v_scrollbar(self,vbar, widget, x, y, w, h, pw, ph):
        widget.configure(yscrollcommand=vbar.set)
        vbar.config(command=widget.yview)
        vbar.place(relx=(w + x) / pw, rely=y / ph, relheight=h / ph, anchor='ne')
    def h_scrollbar(self,hbar, widget, x, y, w, h, pw, ph):
        widget.configure(xscrollcommand=hbar.set)
        hbar.config(command=widget.xview)
        hbar.place(relx=x / pw, rely=(y + h) / ph, relwidth=w / pw, anchor='sw')
    def create_bar(self,master, widget,is_vbar,is_hbar, x, y, w, h, pw, ph):
        vbar, hbar = None, None
        if is_vbar:
            vbar = Scrollbar(master)
            self.v_scrollbar(vbar, widget, x, y, w, h, pw, ph)
        if is_hbar:
            hbar = Scrollbar(master, orient="horizontal")
            self.h_scrollbar(hbar, widget, x, y, w, h, pw, ph)
        self.scrollbar_autohide(vbar, hbar, widget)
    def new_style(self,widget):
        ctl = widget.cget('style')
        ctl = "".join(random.sample('0123456789',5)) + "." + ctl
        widget.configure(style=ctl)
        return ctl

    # 主功能
    def __tk_label_title(self,parent):
        label = Label(parent, text="  只学习不玩耍，聪明三月也变傻", anchor="w", bootstyle="warning inverse", background='blue')
        label.place(x=0, y=0, width=1000, height=50)
        return label
    def __tk_text_Result(self, parent):
        text = Text(parent, wrap=tk.WORD, insertbackground="white", font=("Helvetica", 12), background='black')
        text.place(x=50, y=190, width=900, height=250)
        # text.place(x=60, y=320, width=700, height=134)
        self.create_bar(parent, text, True, True, 50, 180, 900, 250, 1000, 500)
        return text
