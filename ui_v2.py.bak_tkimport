    def __tk_text_bgcolor_demo(self, parent):
        text = Text(parent,
                      bg="black",    # 背景色设置为黑色
                      fg="white",    # 字体颜色设置为白色
                      insertbackground="white",  # 插入光标颜色设置为白色
                      font=("Arial", 12))  # 设置字体和大小
        text.place(x=0, y=0, width=200, height=200)
        text.insert(1.0, "示例文字", 'red')
        return text

    def __tk_button_upload_file(self, parent):
        # btn = Button(parent, text="导入", takefocus=False, bootstyle="default", command=self.upload_file)
        btn = Button(parent, text="导入")
        btn.place(x=625, y=103, width=50, height=30)
        return btn

    # 辅助函数
    def update_time(self):
        current_time = time.strftime("%H:%M", time.localtime())
        self.tk_text_time["text"] = current_time
        self.tk_text_time.after(1000, self.update_time)  # 每秒更新一次时间


class Win(WinGUI):
    def __init__(self, controller):
        self.ctl = controller
        super().__init__()
        self.__event_bind()
        self.__style_config()
        self.ctl.init(self)
    def __event_bind(self):
        self.tk_input_keyword1.bind('<Return>',self.ctl.search1_1)
        self.tk_input_keyword2.bind('<Return>',self.ctl.Search2_2)
        self.tk_button_search2.bind('<Button-1>',self.ctl.GetResult)
        self.tk_button_search1.bind('<Button-1>',self.ctl.SearchFromMessage)
        self.tk_input_keyword3.bind('<Return>',self.ctl.Search3_3)
        # self.tk_input_keyword4.bind('<Return>',self.ctl.Search4_4)
        self.tk_button_search3.bind('<Button-1>',self.ctl.GetResult)
        # self.tk_button_search4.bind('<Button-1>',self.ctl.GetResult)
        self.tk_button_upload_file.bind('<Button-1>', self.ctl.upload_file)
        self.ext_icon_return.bind('<Button-1>',self.ctl.return_menu)
        pass
    def __style_config(self):
        sty = Style()
        sty.configure(self.new_style(self.tk_label_title),font=("楷体", -25))
        sty.configure(self.new_style(self.tk_button_search2),font=("微软雅黑", -12))
        sty.configure(self.new_style(self.tk_button_search1),font=("微软雅黑", -12))
        sty.configure(self.new_style(self.tk_button_search3),font=("微软雅黑", -12))
        # sty.configure(self.new_style(self.tk_button_search4),font=("微软雅黑", -12))
        sty.configure(self.new_style(self.tk_button_upload_file),font=("微软雅黑", -12))
        pass


if __name__ == "__main__":
